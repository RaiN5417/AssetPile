{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AssetPile｜材栈",
  "version": "0.2.5",
  "identifier": "dev.assetpile.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AssetPile｜材栈",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AssetPile Contributors",
    "copyright": "Copyright © 2026 AssetPile Contributors",
    "homepage": "https://github.com/RaiN5417/AssetPile",
    "shortDescription": "AssetPile｜材栈——本地优先的素材管理器,给下载文件一个真正的家",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
